POSTGRES_USER=credit
POSTGRES_PASSWORD=replace-with-random-database-password
POSTGRES_DB=credit_cabinet
BACKEND_PORT=8000
FRONTEND_PORT=8080
APP_ENV=development
DATABASE_URL=postgresql+psycopg://credit:credit@localhost:5432/credit_cabinet
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:8000","http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
LOG_LEVEL=INFO
DEMO_DATASET_DIR=demo_data/demo_0_3
DOCUMENTS_DIR=.data/documents
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_PARALLEL=1
DEMO_USER_PASSWORD=replace-with-demo-account-password
CSRF_SIGNING_KEY=replace-with-random-secret-at-least-32-characters
CLIENT_SESSION_ABSOLUTE_TTL_SECONDS=28800
CLIENT_SESSION_IDLE_TTL_SECONDS=3600
BANK_SESSION_ABSOLUTE_TTL_SECONDS=14400
BANK_SESSION_IDLE_TTL_SECONDS=900
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
