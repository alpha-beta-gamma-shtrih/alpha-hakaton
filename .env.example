# Backend only; PostgreSQL must already be running. Docker/Compose belong to Dima.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://credit:credit@localhost:5432/credit_cabinet
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:8000","http://localhost:5173"]
COOKIE_SECURE=false
LOG_LEVEL=INFO
DEMO_DATASET_DIR=demo_data/demo_0_2
# Writable persistent directory for private copies of demo CSV documents.
DOCUMENTS_DIR=.data/documents
# Local Ollama; AI availability does not affect credit API readiness.
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
# Optional immutable model pin, in the same format returned by advisor.model_digest.
# LLM_MODEL_DIGEST=sha256:64-lowercase-hex-characters
LLM_TIMEOUT_SECONDS=45
LLM_MAX_PARALLEL=1
# Optional for non-interactive seed (new demo accounts only; 12+ chars).
# DEMO_USER_PASSWORD=
# Generate locally: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
CSRF_SIGNING_KEY=replace-with-random-secret-at-least-32-characters
CLIENT_SESSION_ABSOLUTE_TTL_SECONDS=28800
CLIENT_SESSION_IDLE_TTL_SECONDS=3600
BANK_SESSION_ABSOLUTE_TTL_SECONDS=14400
BANK_SESSION_IDLE_TTL_SECONDS=900
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
