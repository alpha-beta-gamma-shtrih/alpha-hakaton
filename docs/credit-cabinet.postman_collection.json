  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let data;",
          "try { data = pm.response.json(); } catch (_) { data = null; }",
          "if (pm.response.code >= 200 && pm.response.code < 300 && data) {",
          "  if (data.csrf_token) pm.collectionVariables.set('csrf_token', data.csrf_token);",
          "  const app = data.application || data;",
          "  if (app.id && app.company_id && app.status) {",
          "    pm.collectionVariables.set('application_id', app.id);",
          "    if (app.version) pm.collectionVariables.set('version', String(app.version));",
          "    if (pm.response.code === 201) pm.collectionVariables.set('submission_key', pm.variables.replaceIn('{{$guid}}'));",
          "  }",
          "  if (data.application_id && data.version) pm.collectionVariables.set('version', String(data.version));",
          "  if (data.application_version) pm.collectionVariables.set('version', String(data.application_version));",
          "  if (data.preview_hash) pm.collectionVariables.set('preview_hash', data.preview_hash);",
          "  const decision = app.decision || data.decision;",
          "  if (decision && decision.id) pm.collectionVariables.set('decision_id', decision.id);",
          "  const set = data.scenario_set || data;",
          "  if (set.id && set.candidates && set.created_at) pm.collectionVariables.set('scenario_set_id', set.id);",
          "  if (data.content_sha256) {",
          "    pm.collectionVariables.set('content_sha256', data.content_sha256);",
          "    pm.collectionVariables.set('decision_id', data.content.decision_id);",
          "  }",
          "  if (data.model_id !== undefined && data.id) pm.collectionVariables.set('report_id', data.id);",
          "}"
        ]
      }
    }
  ]
